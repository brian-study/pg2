{:paths ["src/clj" "classes"]

 :deps {metosin/jsonista {:mvn/version "0.3.8"}
        less-awful-ssl/less-awful-ssl {:mvn/version "1.0.7"}}

 :deps/prep-lib {:ensure "classes"
                  :alias :build
                  :fn build/javac}

 :aliases {:build {:extra-paths ["."]
                   :extra-deps {io.github.clojure/tools.build {:mvn/version "0.10.11"}}
                   :ns-default build}

           :test {:extra-paths ["test"]
                  :extra-deps {org.clojure/data.csv {:mvn/version "1.0.1"}
                               org.clojure/test.check {:mvn/version "1.1.1"}
                               cheshire/cheshire {:mvn/version "5.13.0"}}}}}
